# SoftEther plugin: generated native artifacts.
# OpenSSL is built from source (see softether_flutter/android/build.gradle);
# the archives and the generated header must never be committed, both to keep
# the tree clean and to stay F-Droid-compliant (no prebuilt binaries).
/softether_flutter/android/src/main/jniLibs/
/softether_flutter/android/src/main/cpp/openssl-build/
/softether_flutter/android/src/main/cpp/openssl/include/openssl/configuration.h
/softether_flutter/android/src/main/cpp/openssl/Makefile
/softether_flutter/.dart_tool/
/softether_flutter/pubspec.lock
/softether_flutter/android/.gradle/
/softether_flutter/android/build/
/softether_flutter/build/
